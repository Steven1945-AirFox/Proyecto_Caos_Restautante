@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Verificación de Código</title>
	<style>
		body {
			margin: 0;
			background: linear-gradient(to bottom right, #ffe0cd, #fbc69f);
			font-family: 'Segoe UI', sans-serif;
			display: flex;
			align-items: center;
			justify-content: center;
			height: 100vh;
		}

		.verification-container {
			width: 100%;
			max-width: 400px;
			background-color: #fff;
			padding: 30px;
			border-radius: 12px;
			box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
			text-align: center;
		}

		.verification-title {
			font-size: 22px;
			margin-bottom: 15px;
			color: #333;
			font-weight: bold;
		}

		.verification-text {
			font-size: 16px;
			margin-bottom: 20px;
			color: #555;
		}

		input[type="text"] {
			width: 100%;
			padding: 12px;
			font-size: 18px;
			margin-bottom: 20px;
			border: 1px solid #ccc;
			border-radius: 6px;
			box-sizing: border-box;
			text-align: center;
			letter-spacing: 3px;
			/* ❌ Se eliminó text-transform para permitir mayúsculas y minúsculas */
		}

		button {
			background-color: #ff661f;
			color: #fff;
			border: none;
			padding: 12px 20px;
			font-size: 16px;
			border-radius: 6px;
			cursor: pointer;
			transition: background-color 0.3s ease;
			width: 100%;
		}

			button:hover {
				background-color: #e65c0c;
			}

		.resend {
			margin-top: 15px;
			font-size: 14px;
		}

			.resend a {
				color: #ff661f;
				text-decoration: none;
				font-weight: bold;
			}

				.resend a:hover {
					text-decoration: underline;
				}

		.error-msg {
			color: red;
			margin-top: 15px;
			font-weight: bold;
		}

		.debug-msg {
			color: blue;
			margin-top: 10px;
			font-size: 13px;
		}
	</style>
</head>
<body>
	<div class="verification-container">
		<div class="verification-title">Código de Verificación</div>
		<div class="verification-text">Ingresa el código que enviamos a tu correo electrónico.</div>

		@using (Html.BeginForm("ValidarCodigo", "Home", FormMethod.Post))
		{
			<input type="text" name="codigoIngresado" aria-label="Código de verificación" placeholder="Ej: X9A2B7" required />
			<button type="submit">Verificar Código</button>
		}

		<div class="resend">
			¿No recibiste el código?
			<a href="@Url.Action("ReenviarCodigo", "Home")">Reenviar</a>
		</div>

		@if (TempData["Error"] != null)
		{
			<div class="error-msg">@TempData["Error"]</div>
		}

		@if (TempData["DebugRol"] != null)
		{
			<div class="debug-msg">@TempData["DebugRol"]</div>
		}
	</div>
</body>
</html>
