@{
    ViewBag.Title = "Recuperar Contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>Recuperar Contraseña</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("SolicitarCodigo", "Home", FormMethod.Post, new { id = "recoveryForm", autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            @Html.Label("Correo electrónico:")
                            @Html.TextBox("email", null, new { @class = "form-control", type = "email", required = "required" })
                            <div id="emailError" class="text-danger small mt-1"></div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block mt-3" id="submitButton">
                            <span id="submitText">Enviar Código</span>
                            <span id="loadingSpinner" style="display:none;">
                                <i class="fas fa-spinner fa-spin"></i> Enviando...
                            </span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#recoveryForm").submit(function (e) {
                e.preventDefault();

                var $form = $(this);
                var $submitButton = $("#submitButton");
                var $submitText = $("#submitText");
                var $loadingSpinner = $("#loadingSpinner");
                var $emailError = $("#emailError");

                // Mostrar loading
                $submitText.hide();
                $loadingSpinner.show();
                $submitButton.prop("disabled", true);
                $emailError.text("");

                // Enviar formulario via AJAX
                $.ajax({
                    url: "@Url.Action("SolicitarCodigo", "Home")",
                    type: "POST",
                    data: $form.serialize(),
                    dataType: "json",
                    success: function (response) {
                        if (response.success && response.redirectUrl) {
                            // Redirigir si la respuesta contiene una URL
                            window.location.href = response.redirectUrl;
                        } else if (!response.success && response.message) {
                            // Mostrar mensaje de error
                            $emailError.text(response.message);
                        }
                    },
                    error: function (xhr) {
                        var errorMessage = "Error al procesar la solicitud";
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }
                        $emailError.text(errorMessage);
                    },
                    complete: function () {
                        $submitText.show();
                        $loadingSpinner.hide();
                        $submitButton.prop("disabled", false);
                    }
                });
            });
        });
    </script>
}